# Runtime environment and API listener.
NODE_ENV=development
PORT=3000

# Persistent SQLite file (created automatically on first startup).
DATABASE_PATH=./data/health.sqlite

# Structured log level and allowed development dashboard origin.
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Rolling evaluation window in minutes (1-1440).
HEALTH_WINDOW_MINUTES=15
